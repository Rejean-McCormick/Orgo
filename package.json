{
  "name": "orgo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w api && npm run build -w web",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm run test -w api",
    "test:integration": "npm run test:integration -w api",
    "check:architecture": "node scripts/check-architecture.mjs",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "worker": "npm run worker -w api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "test:pglite": "node scripts/test-pglite.mjs",
    "validate:local": "node scripts/validate-local.mjs",
    "migration:preflight": "node scripts/legacy-preflight.mjs"
  },
  "overrides": {
    "multer": "2.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "prettier": "^3.6.2"
  }
}
