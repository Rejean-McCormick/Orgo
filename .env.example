# Compose: use a URL-safe database password, e.g. random hexadecimal.
POSTGRES_PASSWORD=
# Optional host-port overrides for isolated/local Compose runs. Defaults remain 4000/3000.
# ORGO_API_HOST_PORT=4000
# ORGO_WEB_HOST_PORT=3000
ORGO_ADMIN_PASSWORD=
ORGO_ADMIN_EMAIL=admin@example.test
ORGO_ORGANIZATION=orgo
# Local Node processes: point at your running PostgreSQL instance.
DATABASE_URL=postgresql://orgo:CHANGE_ME@localhost:5432/orgo
PORT=4000
# Set before building Next if API and web do not share localhost.
ORGO_API_URL=http://localhost:4000
SMTP_URL=
SMTP_FROM=
KRISTAL_BRIDGE_URL=
KRISTAL_BRIDGE_TOKEN=
KONNAXION_BRIDGE_URL=
KONNAXION_BRIDGE_TOKEN=
ARCHITECT_BRIDGE_URL=
ARCHITECT_BRIDGE_TOKEN=
KOA_BRIDGE_URL=
KOA_BRIDGE_TOKEN=

# Public HTTPS origin for invitation/recovery links and OIDC callback /sso.
ORGO_PUBLIC_URL=
# Optional single configured OpenID issuer. Explicit issuer/subject mappings are required.
# Production OIDC URLs require HTTPS. Non-production may use http://localhost / 127.0.0.1 for a local IdP.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=kOA Identity
# Standalone MIME/IMAP adapter (scripts/email-ingress.py)
ORGO_INGRESS_TOKEN=
ORGO_EMAIL_LABEL=2.11
ORGO_EMAIL_WORKFLOW_VERSION=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional fixed delivery gateways. POST must honor Idempotency-Key and return {"status":"delivered"}.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
WEBHOOK_GATEWAY_URL=
WEBHOOK_GATEWAY_TOKEN=

# Local-only convenience. When true, the web UI can create an admin session without re-entering the password.
# Keep false for shared or production deployments.
ORGO_LOCAL_AUTO_LOGIN=false


# Interaction Kernel (Konnaxion <-> Orgo)
KONNAXION_IK_URL=
KONNAXION_IK_TOKEN=
KONNAXION_IK_WORLD=
# Inbound Konnaxion decision routing. Example endpoint: /api/v3/ik/interactions
KONNAXION_DECISION_WORKFLOW_CODE=
KONNAXION_DECISION_LABEL=1.11
KONNAXION_DECISION_TYPE=governance_decision
KONNAXION_DECISION_CATEGORY=request
KONNAXION_DECISION_SEVERITY=MODERATE
# Optional expected World routing hint. Empty means no World enforcement in Orgo core.
ORGO_IK_WORLD=
# Local Docker-only escape hatch for http://host.docker.internal provider URLs. Keep false outside local qualification.
ORGO_ALLOW_INSECURE_LOCAL_PROVIDER_HTTP=false
