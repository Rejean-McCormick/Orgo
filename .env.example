# Compose: use a URL-safe database password, e.g. random hexadecimal.
POSTGRES_PASSWORD=
ORGO_ADMIN_PASSWORD=
ORGO_ADMIN_EMAIL=admin@example.test
ORGO_ORGANIZATION=orgo
# Local Node processes: point at your running PostgreSQL instance.
DATABASE_URL=postgresql://orgo:CHANGE_ME@localhost:5432/orgo
PORT=4000
# Set before building Next if API and web do not share localhost.
ORGO_API_URL=http://localhost:4000
SMTP_URL=
SMTP_FROM=
KRISTAL_BRIDGE_URL=
KRISTAL_BRIDGE_TOKEN=
KONNAXION_BRIDGE_URL=
KONNAXION_BRIDGE_TOKEN=
ARCHITECT_BRIDGE_URL=
ARCHITECT_BRIDGE_TOKEN=
KOA_BRIDGE_URL=
KOA_BRIDGE_TOKEN=

# Public HTTPS origin for invitation/recovery links and OIDC callback /sso.
ORGO_PUBLIC_URL=
# Optional single configured OpenID issuer. Explicit issuer/subject mappings are required.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Standalone MIME/IMAP adapter (scripts/email-ingress.py)
ORGO_INGRESS_TOKEN=
ORGO_EMAIL_LABEL=2.11
ORGO_EMAIL_WORKFLOW_VERSION=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional fixed delivery gateways. POST must honor Idempotency-Key and return {"status":"delivered"}.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
WEBHOOK_GATEWAY_URL=
WEBHOOK_GATEWAY_TOKEN=
